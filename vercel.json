{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,

  "redirects": [
    { "source": "/upcoming-events", "destination": "/events.html", "permanent": true },
    { "source": "/upcoming-events/:path*", "destination": "/events.html", "permanent": true },
    { "source": "/join", "destination": "/membership.html", "permanent": true },
    { "source": "/contact", "destination": "/inquire.html", "permanent": true }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
